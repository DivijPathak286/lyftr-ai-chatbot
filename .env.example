# Add at least two valid provider API keys. Never commit real keys.
LLM_API_KEYS=replace-with-key-one,replace-with-key-two
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional OpenAI-compatible endpoint (leave blank for provider default)
LLM_API_BASE=
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, accurate assistant.
LLM_TIMEOUT_SECONDS=45
LITELLM_CACHE_DIR=/data/litellm-cache
# Used by the frontend Docker build for hosted deployment; local compose uses localhost.
VITE_API_BASE_URL=http://localhost:8000
